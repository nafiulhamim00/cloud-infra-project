project_name = "cloudinfra"
location     = "swedencentral"
environment  = "dev"
app_image    = "docker.io/nafiulhamim/demo-app"
app_version  = "latest"

db_name = "webapp"
db_user = "webuser"

# Leave blank to auto-generate a random password (recommended):
db_password = ""

# Your public IP (e.g. from `curl ifconfig.me`), so you can connect with a
# MySQL client to load the schema. Leave blank to skip.
my_ip_address = ""
