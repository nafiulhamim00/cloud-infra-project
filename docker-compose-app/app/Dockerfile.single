# The simplest possible way to build and run the app: one stage, no cache
# tricks, no non-root user. Compare its size to Dockerfile_sol's.
FROM golang:1.26-alpine

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -o /app/dat515-app .

EXPOSE 8080

CMD ["/app/dat515-app"]
